# Dead Time B2B — Environment Variables
# ----------------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Your Google Gemini API key (get one at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override hourly rate for ROI calculations (default: 50)
# DEFAULT_HOURLY_RATE_GBP=50

# Optional: Ingestion security token (if set, extension must provide Authorization: Bearer <token>)
# DEADTIME_INGEST_TOKEN=secret_pilot_token_123
